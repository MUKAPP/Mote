<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        android:usesCleartextTraffic 在平台层放行明文，以支持局域网自建服务（Ollama / LM Studio / SearXNG）。
        network-security-config 只能按主机名后缀匹配，无法表达「仅私有网段」，
        所以实际策略由 util/CleartextGuard 在应用层执行：携带密钥的模型接口与搜索请求禁止明文发往公网地址。
    -->
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Mote">
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:theme="@style/Theme.Mote"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProviderEditorActivity"
            android:exported="false"
            android:label="@string/title_provider_editor"
            android:theme="@style/Theme.Mote"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FreeCopyActivity"
            android:exported="false"
            android:label="@string/title_free_copy"
            android:theme="@style/Theme.Mote" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
