<?xml version="1.0" encoding="utf-8"?><!--
   自动备份规则（API 30 及以下走 fullBackupContent）。
   默认会备份 SharedPreferences 与 filesDir 下的全部内容，
   因此必须显式排除 API 密钥与聊天记录，避免它们进入云备份 / adb backup。
-->
<full-backup-content>
    <!-- ApiSettingsStore.PrefName：包含各提供商 baseUrl 与 apiKey -->
    <exclude
        domain="sharedpref"
        path="mote_api_settings.xml" />
    <!-- ChatHistoryStore：会话正文、工具输出、图片 Base64 -->
    <exclude
        domain="file"
        path="chat_history" />
</full-backup-content>
