<?xml version="1.0" encoding="utf-8"?><!--
   数据提取规则（API 31 及以上）。
   cloud-backup 与 device-transfer 均排除 API 密钥和聊天记录：
   前者会上传到 Google 服务器，后者虽为本地直传但同样承载明文密钥。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="mote_api_settings.xml" />
        <exclude
            domain="file"
            path="chat_history" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="mote_api_settings.xml" />
        <exclude
            domain="file"
            path="chat_history" />
    </device-transfer>
</data-extraction-rules>
